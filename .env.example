# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pan_africa_pay
DATABASE_MAX_CONNECTIONS=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10

# M-Pesa Daraja (Sandbox)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORT_CODE=
MPESA_CALLBACK_URL=http://localhost:3000/webhooks/mpesa
MPESA_ENVIRONMENT=sandbox
# Optional: point the client at a mock server (leave empty for sandbox/production)
MPESA_BASE_URL_OVERRIDE=

# Kotani Pay (Sandbox)
KOTANI_API_KEY=
KOTANI_API_SECRET=
KOTANI_BASE_URL=https://sandbox-api.kotanipay.io
KOTANI_WEBHOOK_SECRET=
KOTANI_WALLET_ID=
KOTANI_CALLBACK_URL=http://localhost:3000/webhooks/kotani

# JWT Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20